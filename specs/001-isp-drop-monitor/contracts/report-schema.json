{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Laudo Pericial de Auditoria de Conexão ISP Schema",
  "description": "Estrutura dos dados consolidados que formam o documento de laudo técnico em PDF e seu Hash SHA-256",
  "type": "object",
  "required": [
    "reportId",
    "createdAt",
    "period",
    "summary",
    "events",
    "integrity"
  ],
  "properties": {
    "reportId": {
      "type": "string",
      "format": "uuid"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "customer": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "isp": { "type": "string" },
        "contractNumber": { "type": "string" },
        "protocol": { "type": "string" }
      }
    },
    "period": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string", "format": "date-time" },
        "end": { "type": "string", "format": "date-time" }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "totalComputerUptimeSeconds",
        "totalIspDowntimeSeconds",
        "effectiveAvailabilityPct",
        "totalOutageEventsCount"
      ],
      "properties": {
        "totalComputerUptimeSeconds": { "type": "integer" },
        "totalIspDowntimeSeconds": { "type": "integer" },
        "effectiveAvailabilityPct": { "type": "number", "minimum": 0, "maximum": 100 },
        "totalOutageEventsCount": { "type": "integer" },
        "flappingWindowsCount": { "type": "integer" },
        "regulatoryTargetPct": { "type": "number", "default": 99.0 }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["startTime", "endTime", "durationSeconds", "category"],
        "properties": {
          "startTime": { "type": "string", "format": "date-time" },
          "endTime": { "type": "string", "format": "date-time" },
          "durationSeconds": { "type": "integer" },
          "category": { "type": "string", "enum": ["ISP_EXTERNAL_FAILURE", "LOCAL_ROUTER_FAILURE"] },
          "packetLossPct": { "type": "number" }
        }
      }
    },
    "integrity": {
      "type": "object",
      "required": ["sha256", "algorithm"],
      "properties": {
        "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "algorithm": { "type": "string", "default": "SHA-256" }
      }
    }
  }
}
